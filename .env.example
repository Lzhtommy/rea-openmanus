# Model provider: litellm, openai, anthropic, google, xai, deepseek, moonshot, zhipu, qwen,
# siliconflow, openrouter, fireworks, or custom (any OpenAI-compatible URL: vLLM, Ollama, Azure, ...)
MANUS_LLM_PROVIDER=litellm
# Required for litellm and custom; for other providers it overrides their default URL
MANUS_LLM_BASE_URL=https://your-litellm-gateway.example.com
MANUS_LLM_API_KEY=
# Empty: the provider's suggested model
MANUS_MODEL=claude-opus-5-5
TAVILY_API_KEY=
MANUS_SANDBOX=docker
MANUS_PUBLIC_URL=http://localhost:8000
# Media generation through the gateway (leave empty to turn a capability off)
MANUS_IMAGE_MODEL=
MANUS_TTS_MODEL=
MANUS_VIDEO_MODEL=
